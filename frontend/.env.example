# AgriSahayak Frontend – Environment Variables
# Copy to .env.local and set the URL of the running backend

# Backend API base URL
# Development: http://localhost:3001
# Production (Render): https://your-app.onrender.com
VITE_API_URL=http://localhost:3001

# Formspree feedback endpoint (create one at https://formspree.io/)
# Example: https://formspree.io/f/your-form-id
VITE_FORMSPREE_ENDPOINT=your_url
