// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Agricultural Knowledge ──────────────────────────────

model Crop {
  id             String       @id @default(cuid())
  slug           String       @unique
  name           String
  description    String
  type           String       // grain, pulse, oilseed, fruit, vegetable, flower, exotic, fabric
  expectedYield  Float        // quintal/acre
  profitability  Int          // 0-100
  sustainability Int          // 0-100
  mspPrice       Float        // ₹/quintal (0 if no MSP)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  seasons        CropSeason[]
  soilTypes      CropSoil[]

  @@index([type])
}

model Season {
  id        String       @id @default(cuid())
  slug      String       @unique // kharif, rabi, summer, zaid
  name      String
  months    String       // e.g. "Jun–Nov"
  crops     CropSeason[]
}

model SoilType {
  id    String     @id @default(cuid())
  slug  String     @unique // loamy, alluvial, black-soil, sandy-loam, etc.
  name  String
  crops CropSoil[]
}

// Many-to-many: Crop ↔ Season
model CropSeason {
  cropId   String
  seasonId String
  crop     Crop   @relation(fields: [cropId], references: [id], onDelete: Cascade)
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@id([cropId, seasonId])
}

// Many-to-many: Crop ↔ SoilType
model CropSoil {
  cropId     String
  soilTypeId String
  crop       Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  soilType   SoilType @relation(fields: [soilTypeId], references: [id], onDelete: Cascade)

  @@id([cropId, soilTypeId])
}

// ─── Disease Knowledge ───────────────────────────────────

model Disease {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  scientificName String?
  description    String
  cause          String
  symptoms       String[]
  treatment      String[]
  prevention     String[]
  severity       String   // mild, moderate, severe
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([severity])
}
