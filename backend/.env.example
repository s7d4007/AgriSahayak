# =========================================================
# AgriSahayak Backend – Environment Variables
# Copy to .env and fill in your values
# NEVER commit the real .env file
# =========================================================

# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL via Prisma)
# Local example: postgresql://postgres:password@localhost:5432/agrisahayak
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/agrisahayak

# Hugging Face – Plant Disease Detection
# Get token from https://huggingface.co/settings/tokens
HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxx
# Model to use (default: nateraw/vit-base-patch16-224-plant-disease)
HF_MODEL_ID=nateraw/vit-base-patch16-224-plant-disease

# OpenWeatherMap
# Get key from https://openweathermap.org/api
OPENWEATHER_KEY=xxxxxxxxxxxxxxxxxxxx

# CORS – Frontend origin (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173
